{
  "version": "1.0.0",
  "shared": {
    "description": "图表统一模板：使用 templateKey 区分图表类型，props 放公共/专属参数，extra 用于多展示内容扩展。",
    "commonPropKeys": ["chartHeight", "years", "seriesData"],
    "extraPayloadKeys": ["summary", "unit", "showMode", "extendFields"]
  },
  "templates": {
    "line-with-table": {
      "component": "LineChartWithTable",
      "supportedProps": ["chartHeight", "years", "seriesData", "seriesMeanings", "showDataLabel"],
      "defaultProps": {
        "chartHeight": 420,
        "showDataLabel": true
      }
    },
    "line-percent": {
      "component": "LinePercentChart",
      "supportedProps": ["chartHeight", "years", "seriesData", "seriesMeanings", "showMeaning", "yAxisMin", "yAxisMax"],
      "defaultProps": {
        "chartHeight": 380,
        "showMeaning": false,
        "yAxisMin": 0,
        "yAxisMax": 6
      }
    },
    "grouped-bar-percent": {
      "component": "GroupedBarPercentChart",
      "supportedProps": ["chartHeight", "years", "seriesData", "showDataLabel"],
      "defaultProps": {
        "chartHeight": 620,
        "showDataLabel": true
      }
    },
    "province-line": {
      "component": "ProvinceLineChart",
      "supportedProps": ["chartHeight", "provinces", "seriesData"],
      "defaultProps": {
        "chartHeight": 500
      }
    },
    "annual-handle-bar": {
      "component": "AnnualHandleTypeBarChart",
      "supportedProps": ["chartHeight", "years", "seriesData"],
      "defaultProps": {
        "chartHeight": 500
      }
    },
    "china-map": {
      "component": "MapChart",
      "supportedProps": ["chartHeight", "mapData", "titleText"],
      "defaultProps": {
        "chartHeight": 800,
        "titleText": "涉及各省市区代表团的建议数量"
      }
    }
  },
  "charts": [
    {
      "id": "proposal-trend",
      "title": "建议提案趋势图",
      "templateKey": "line-with-table",
      "props": {
        "years": ["2020年", "2021年", "2022年", "2023年", "2024年"],
        "seriesData": [
          { "name": "人大建议", "color": "#4A86C5", "data": [413, 451, 387, 289, 311] },
          { "name": "政协提案", "color": "#C0504D", "data": [210, 231, 260, 156, 117] },
          { "name": "建议提案总数", "color": "#89B34A", "data": [623, 682, 647, 445, 428] }
        ],
        "seriesMeanings": {
          "人大建议": "人大建议数量",
          "政协提案": "政协提案数量",
          "建议提案总数": "人大建议与政协提案总量"
        }
      },
      "extra": {
        "summary": "展示近五年建议提案规模变化趋势",
        "unit": "件",
        "showMode": "table+meaning",
        "extendFields": {
          "showDataLabel": true
        }
      }
    },
    {
      "id": "proposal-yoy",
      "title": "建议提案同比趋势图",
      "templateKey": "line-percent",
      "props": {
        "years": ["2020年", "2021年", "2022年", "2023年", "2024年"],
        "seriesData": [
          { "name": "人大建议同比", "color": "#4A86C5", "data": [4.5, 5.02, 4.21, 3.48, 3.37] },
          { "name": "政协提案同比", "color": "#C0504D", "data": [4.33, 4.68, 5.22, 3.33, 2.34] }
        ],
        "seriesMeanings": {
          "人大建议同比": "人大建议同比增长率",
          "政协提案同比": "政协提案同比增长率"
        },
        "showMeaning": false,
        "yAxisMin": 0,
        "yAxisMax": 6
      },
      "extra": {
        "summary": "可切换同比展示说明区",
        "unit": "%",
        "showMode": "line-only",
        "extendFields": {
          "showMeaning": false
        }
      }
    },
    {
      "id": "civil-service-percent",
      "title": "民政业务分类占比柱状图",
      "templateKey": "grouped-bar-percent",
      "props": {
        "years": ["2020年", "2021年", "2022年", "2023年", "2024年"],
        "seriesData": [
          { "name": "社会组织", "color": "#5B9BD5", "data": [8.9, 5.4, 5.9, 10.1, 6.2] },
          { "name": "社会救助", "color": "#ED7D31", "data": [8.9, 7.3, 4.7, 5.6, 11.0] },
          { "name": "区划地名", "color": "#A5A5A5", "data": [3.1, 3.7, 2.0, 2.7, 1.8] },
          { "name": "社会事务", "color": "#FFC000", "data": [7.6, 8.1, 10.2, 11.7, 9.3] },
          { "name": "养老服务", "color": "#4472C4", "data": [28.6, 33.5, 43.1, 56.3, 59.3] },
          { "name": "儿童福利", "color": "#70AD47", "data": [5.9, 9.6, 9.6, 5.1, 8.0] },
          { "name": "慈善事业", "color": "#255E91", "data": [10.7, 9.6, 8.5, 8.3, 4.1] },
          { "name": "社区治理", "color": "#9E480E", "data": [26.3, 22.8, 16.0, 0, 0] }
        ]
      },
      "extra": {
        "summary": "按业务类别展示年度占比",
        "unit": "%",
        "showMode": "group-bar",
        "extendFields": {
          "showDataLabel": true
        }
      }
    },
    {
      "id": "province-year-line",
      "title": "各省份年度折线图",
      "templateKey": "province-line",
      "props": {
        "chartHeight": 500
      },
      "extra": {
        "summary": "省份维度多序列趋势对比",
        "unit": "件",
        "showMode": "line+table"
      }
    },
    {
      "id": "annual-handle-type",
      "title": "建议提案办理类型年度柱状图",
      "templateKey": "annual-handle-bar",
      "props": {
        "chartHeight": 500,
        "years": ["2020", "2021", "2022", "2023", "2024"],
        "seriesData": [
          { "name": "主办（独办、分办）", "color": "#4F81BD", "data": [250, 257, 270, 215, 232] },
          { "name": "协办、会办", "color": "#C0504D", "data": [384, 356, 340, 215, 194] },
          { "name": "参阅", "color": "#9BBB59", "data": [89, 115, 107, 43, 28] }
        ]
      },
      "extra": {
        "summary": "按办理类型对比年度数量",
        "unit": "件",
        "showMode": "group-bar"
      }
    },
    {
      "id": "china-map-distribution",
      "title": "涉及各省市区代表团的建议数量",
      "templateKey": "china-map",
      "props": {
