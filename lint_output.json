t\t\t\t\t\t<td class=\"score-total\">{{ student.total }}</td>\r\n\t\t\t\t\t\t<td>{{ index + 1 }}</td>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t</tbody>\r\n\t\t\t</table>\r\n\t\t</div>\r\n\t</div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'Test',\r\n  data() {\r\n    return {\r\n      scoreSortOrder: 'desc',\r\n      students: [\r\n        { name: '赵新宇', chinese: 88, math: 92, english: 85 },\r\n        { name: '钱丽娜', chinese: 95, math: 90, english: 93 },\r\n        { name: '孙可欣', chinese: 76, math: 82, english: 79 },\r\n        { name: '李梓涵', chinese: 90, math: 89, english: 94 },\r\n        { name: '周子晨', chinese: 84, math: 78, english: 88 }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    sortedStudents() {\r\n      const order = this.scoreSortOrder === 'asc' ? 1 : -1\r\n      return this.students\r\n        .map((student) => ({\r\n          ...student,\r\n          total: student.chinese + student.math + student.english\r\n        }))\r\n        .sort((a, b) => (a.total - b.total) * order)\r\n    },\r\n    scoreSortLabel() {\r\n      return this.scoreSortOrder === 'asc' ? '升序' : '降序'\r\n    }\r\n  },\r\n  methods: {\r\n    toggleScoreSort() {\r\n      this.scoreSortOrder = this.scoreSortOrder === 'asc' ? 'desc' : 'asc'\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.page {\r\n\tpadding: 12px 0 24px;\r\n}\r\n\r\n.punch-card {\r\n\tdisplay: flex;\r\n\talign-items: center;\r\n\tgap: 18px;\r\n\tpadding: 24px;\r\n\tmargin: 32px auto 18px;\r\n\tmax-width: 520px;\r\n\tbackground: #ffffff;\r\n\tborder: 1px solid #e6ecf7;\r\n\tborder-radius: 16px;\r\n\tbox-shadow: 0 8px 22px rgba(31, 59, 114, 0.08);\r\n}\r\n\r\n.icon-wrap {\r\n\twidth: 84px;\r\n\theight: 84px;\r\n\tdisplay: grid;\r\n\tplace-items: center;\r\n\tbackground: #f0f6ff;\r\n\tborder-radius: 20px;\r\n}\r\n\r\n.punch-icon {\r\n\twidth: 64px;\r\n\theight: 64px;\r\n}\r\n\r\n.text h1 {\r\n\tmargin: 0;\r\n\tfont-size: 22px;\r\n\tcolor: #1f2a44;\r\n}\r\n\r\n.text p {\r\n\tmargin: 8px 0 0 0;\r\n\tf