8539\r\n\r\n// 重新生成摘要的本地化方法 postman调用 post\r\nhttp://172.16.125.13:1025/v1/chat/completions\r\n请求参数\r\n{\r\n    \"model\": \"qwen3-32b\",\r\n    \"stream\": false,\r\n    \"messages\": [\r\n    {\r\n        \"role\": \"user\",\r\n        \"content\": \"你是一个高效问答助手，请直接给出问题的最简答案，不要包含任何分析过程。请为以下文档生成简洁的摘要，要求：\\n1.准确提取文档内容中的关键信息，生成的摘要包含原文关键信息，不添加主观内容\\n2.字数不大于200\\n针对生成的摘要,有序号排列的则改为“一是...”,“二是...”排序\\n文档内容：\\n（一）纳入国家试点布局​建议国家卫生健康委将黑龙江省列为“十五五”低生育水平地区实施积极生育支持政策试点省份，纳入国家人口发展战略布局试点。赋予我省在生育补贴标准制定、假期制度优化、生育成本分担机制建设等领域的改革自主权，允许我省结合边疆地区、农村地区实际情况，可以突破现有政策限制，制定差异化、针对性的政策细则。支持我省在边境地区人口集聚、农村托育服务创新、生育友好型社会建设等方面先行先试，在政策审批、项目立项、资金分配等方面给予倾斜。（二）支持人口发展研究与人才培养​支持我省建设国家级人口发展研究平台，协调全国高校、科研院所、智库等资源，围绕低生育率应对、边境人口稳定、农村人口发展、生育支持政策优化等重大课题开展专项研究，为实验区建设提供理论支撑和决策参考。将我省托育从业人员、人口服务管理人员纳入全国性培养计划，给予培训经费补贴，支持开展跨省交流培训。推动发达地区专业人才向我省柔性流动，建立“国家专家智库对口支援机制”，协调人口学、社会学、公共卫生、托育服务等领域的专家学者到我省开展项目合作、技术指导；支持我省引进高层次人口发展研究和托育服务专业人才，给予国家级人才项目申报倾斜和生活待遇保障。​（三）强化托育服务政策与资金支持​建议国家将我省纳入首批全国托育服务补助示范试点省份，结合我省托育服务设施建设需求和在托儿童数量等实际，在中央财政托育服务专项资金分配中给予倾斜，提高补助标准。支持我省制定《黑龙江省托育服务条例》，提供政策指导和技术支持，协助我省完善条例内容，明确托育服务的政府责任、服务标准、监管机制等，为托育服务发展提供法治保障。优先在我省边境城市、人口流失严重地区布局国家级托育服务示范项目，支持建设一批标准化、规范化的托育服务示范机构和社区嵌入式托育中心；协调国家相关部门将托育服务设施建设纳入城乡公共服务设施配套规划，在土地供应、规划审批、税费减免等方面给予政策支持，保障托育服务项目顺利落地。建议国家卫生健康委在“十五五”国民健康规划中设立7黑龙江省生育友好型社会实验区予以研究支持。黑龙江省将立足边疆实际、聚焦核心难题、强化改革创新，以高度的政治责任感，当好试点主体、落好试点工作、完成好试点目标，努力探索出人口高质量发展与稳边固边相统一的实践路径，为全国积极应对人口形势变化积累宝贵经验。\"\r\n    }\r\n]\r\n}\r\n\r\n\r\n"},{"filePath":"D:\\中国软件CSC\\RD\\search_web\\src\\utils\\摘要执行方法.js","messages":[],"errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"D:\\中国软件CSC\\RD\\search_web\\src\\views\\adviceSearch\\adviceCluster.vue","messages":[],"errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"D:\\中国软件CSC\\RD\\search_web\\src\\views\\adviceSearch\\components\\AdviceClusterLeft.vue","messages":[],"errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"D:\\中国软件CSC\\RD\\search_web\\src\\views\\adviceSearch\\components\\AdviceClusterRight.vue","messages":[],"errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"D:\\中国软件CSC\\RD\\search_web\\src\\views\\adviceSearch\\components\\upload.vue","messages":[],"errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"D:\\中国软件CSC\\RD\\search_web\\src\\views\\adviceSearch\\demo02.vue","messages":[{"ruleId":"vue/no-unused-vars","severity":2,"message":"'scope' is defined but never used.","line":187,"column":33,"nodeType":"Identifier","endLine":187,"endColumn":38},{"ruleId":"no-dupe-keys","severity":2,"message":"Duplicate key 'id'.","line":375,"column":11,"nodeType":"ObjectExpression","messageId":"unexpected","endLine":375,"endColumn":13}],"errorCount":2,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<template>\r\n  <div class=\"advice-layout\">\r\n    <!-- 左侧：筛选与初次结果 -->\r\n    <div class=\"left-pane\">\r\n      <el-tabs v-model=\"activeLeftTab\" type=\"card\" class=\"left-tabs\">\r\n        <el-tab-pane label=\"搜索检索\" name=\"search\">\r\n          <div class=\"filter-card\">\r\n            <div class=\"filter-row two-cols\">\r\n              <div class=\"filter-col\">\r\n                <span class=\"filter-label\">类别：</span>\r\n                <el-select v-model=\"leftSelectCategory\" placeholder=\"选择类别\" class=\"filter-select\" @change=\"onLeftCategoryChange\">\r\n                  <el-option label=\"热点问题\" value=\"hotspot\"></el-option>\r\n                  <el-option label=\"重点建议\" value=\"keySuggestion\"></el-option>\r\n                </el-select>\r\n              </div>\r\n              <div class=\"filter-col\">\r\n                <span class=\"filter-label\">选项：</span>\r\n                <el-select\r\n                  v-if=\"leftSelectCategory === 'hotspot'\"\r\n                  v-model=\"selectedHotspots\"\r\n                  multiple\r\n                  filterable\r\n                  collapse-tags\r\n                  placeholder=\"热点（可多选）\"\r\n                  class=\"filter-select\"\r\n                  @change=\"onOptionsChange\"\r\n                >\r\n                  <el-option v-for=\"h in hotspots\" :key=\"h.value\" :label=\"h.value\" :value=\"h.value\">{{ h.label }}</el-option>\r\n                </el-select>\r\n                <el-select\r\n                  v-else\r\n                  v-model=\"selectedKeySuggestions\"\r\n                  multiple\r\n                  filterable\r\n                  collapse-tags\r\n                  placeholder=\"重点建议（可多选）\"\r\n                  class=\"filter-select\"\r\n                  @change=\"onOptionsChange\"\r\n                >\r\n                  <el-option v-for=\"k in keySuggestions\" :key=\"k.value\" :label=\"k.label\" :value=\"k.value\"></el-option>\r\n                </el-select>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"search-input-row\">\r\n              <div v-if=\"selectedHotspots.length || selectedKeySuggestions.length\" class=\"search-tags\">\r\n                <el-tag\r\n                  v-for=\"(h, hi) in selectedHotspots\"\r\n                  :key=\"'h-'+hi\"\r\n                  size=\"mini\"\r\n                  type=\"info\"\r\n                  closable\r\n                  @close=\"removeHotspot(h)\"\r\n                  @click.prevent=\"toggleHighlight(h, 'hotspot', null, hi)\"\r\n                  :class=\"['top-kw-tag', highlightedHotspots && highlightedHotspots.includes('hotspot:'+hi) ? 'kw-selected' : 'kw-hotspot']\"\r\n                >{{ h }}</el-tag>\r\n                <el-tag\r\n                  v-for=\"(k, ki) in selectedKeySuggestions\"\r\n                  :key=\"'k-'+ki\"\r\n                  size=\"mini\"\r\n                  type=\"success\"\r\n                  closable\r\n                  @close=\"removeKeySuggestion(k)\"\r\n                  @click.prevent=\"toggleHighlight(k, 'keySuggestion', null, ki)\"\r\n                  :class=\"['top-kw-tag', highlightedKeySuggestions && highlightedKeySuggestions.includes('keySuggestion:'+ki) ? 'kw-selected' : 'kw-keySuggestion']\"\r\n                >{{ k }}</el-tag>\r\n              </div>\r\n              <div class=\"search-textarea\">\r\n                <el-input\r\n                  type=\"textarea\"\r\n                  v-model=\"input3\"\r\n                  :placeholder=\"computedSearchPlaceholder\"\r\n                  clearable\r\n                  @clear=\"resetFilters\"\r\n                  :autosize=\"{ minRows: 2, maxRows: 4 }\"\r\n                  class=\"search-input\"\r\n                ></el-input>\r\n                <el-button type=\"primary\" icon=\"el-icon-search\" class=\"search-btn\" @click=\"onSearch\">一次拓展</el-button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <!-- 一次检索内容 -->\r\n          <div class=\"list-card\">\r\n            <div class=\"filter-row\">\r\n              <span class=\"filter-label\">来源库：</span>\r\n              <el-select v-model=\"selectedCategory\" placeholder=\"请选择来源库\" class=\"filter-select category-select\">\r\n                <el-option v-for=\"c in categories\" :key=\"c.value\" :label=\"c.label\" :value=\"c.value\"></el-option>\r\n              </el-select>\r\n              <div class=\"filter-actions\">\r\n                <el-button type=\"primary\" size=\"small\" @click=\"()=>{}\">二次拓展</el-button>\r\n                <el-button type=\"primary\" size=\"small\" @click=\"secondarySearch\">检索聚类</el-button>\r\n                <el-button size=\"small\" @click=\"clearLeftSelections\">重置</el-button>\r\n              </div>\r\n            </div>\r\n            <div class=\"list-title\">搜索结果（可勾选作为二次检索条件）</div>\r\n            <div class=\"primary-list\">\r\n              <div v-for=\"(item,index) in primaryResults\" :key=\"'p-'+index\" class=\"primary-item\">\r\n                <el-checkbox v-model=\"selectedPrimary\" :label=\"item.title\" @change=\"onItemTitleChange(item)\">\r\n                  <span class=\"result-item-title\">{{ item.title || '未命名' }}</span>\r\n                </el-checkbox>\r\n                <div class=\"result-item-meta\">来源：{{ item.c_fwjg }} ｜ 年份：{{ item.c_nf }}</div>\r\n                <!-- 关键字（改为可点击 Tag 样式） -->\r\n                <div style=\"padding-left:16px\">\r\n                  <span>关键词：</span>\r\n                  <div class=\"kw-group\">\r\n                    <el-tag\r\n                      v-for=\"(kw, ki) in item.keywords\"\r\n                      :key=\"'kw-'+ki\"\r\n                      size=\"mini\"\r\n                      :type=\"(highlightedPrimary && highlightedPrimary.includes('primary:'+index+':'+ki)) ? 'success' : 'info'\"\r\n                      effect=\"plain\"\r\n                      :class=\"['kw-tag', (highlightedPrimary && highlightedPrimary.includes('primary:'+index+':'+ki)) ? 'kw-selected' : '']\"\r\n                      @click.prevent=\"toggleHighlight(kw, 'primary', item, index, ki)\"\r\n                    >{{ kw }}</el-tag>\r\n                  </div>\r\n                </div>\r\n                <div v-if=\"item.segments && item.segments.length\" class=\"item-segments\">\r\n                  <div v-for=\"(seg, sidx) in item.segments\" :key=\"'p-'+index+'-s-'+sidx\" class=\"segment-block\">\r\n                    <!-- 段首语： -->\r\n                    <!-- <div class=\"seg-row\">\r\n                      <el-checkbox v-if=\"seg.intro\" :label=\"seg.intro\" v-model=\"selectedSegmentIntros\"><span class=\"seg-text-inline\">{{ seg.intro }}</span></el-checkbox>\r\n                    </div> -->\r\n                    <!-- 内容： -->\r\n                    <div class=\"seg-row\">\r\n                      <el-checkbox v-if=\"seg.content\" :label=\"seg.content\" v-model=\"selectedSegmentContents\"><span class=\"seg-content-inline\" v-html=\"handleGl(seg.content)\"></span></el-checkbox>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </el-tab-pane>\r\n        <!-- 上传文件 -->\r\n        <el-tab-pane label=\"上传文件\" name=\"upload\">\r\n          <div class=\"upload-card\">\r\n            <div class=\"upload-header\">\r\n              <span class=\"upload-title\">上传文件</span>\r\n              <div class=\"upload-actions\">\r\n                <input ref=\"fileInput\" type=\"file\" multiple style=\"display:none\" @change=\"onFilesSelected\">\r\n                <el-button size=\"small\" type=\"primary\" icon=\"el-icon-upload2\" @click=\"openFileDialog\">选择文件</el-button>\r\n              </div>\r\n            </div>\r\n            <div v-if=\"uploadedFiles.length\" class=\"upload-list\">\r\n              <div v-for=\"(f, idx) in uploadedFiles\" :key=\"f.id\" class=\"upload-item\">\r\n                <div class=\"upload-meta\">\r\n                  <span class=\"upload-name\" :title=\"f.name\">{{ f.name }}</span>\r\n                  <span class=\"upload-size\">{{ f.humanSize }}</span>\r\n                </div>\r\n                <div class=\"upload-buttons\">\r\n                  <el-button v-if=\"f.isImage\" type=\"text\" size=\"mini\" @click=\"previewFile(f)\">预览</el-button>\r\n                  <el-button type=\"text\" size=\"mini\" @click=\"previewFile(f)\">查看</el-button>\r\n                  <el-button type=\"text\" size=\"mini\" @click=\"removeFile(idx)\">删除</el-button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div v-else class=\"upload-empty\">暂无上传文件</div>\r\n          </div>\r\n        </el-tab-pane>\r\n      </el-tabs>\r\n    </div>\r\n\r\n    <!-- 右侧：二次检索结果与摘要 -->\r\n    <div class=\"right-pane\">\r\n      <div class=\"right-toolbar\">\r\n        <div class=\"toolbar-left\">\r\n          <span class=\"right-title\">二次检索结果</span>\r\n        </div>\r\n        <div class=\"toolbar-right\">\r\n          <el-button :type=\"selectedRows.length ? 'primary' : 'default'\" :disabled=\"selectedRows.length === 0\" @click=\"exportRepresentatives\" :loading=\"repLoading\" style=\"margin-right:8px\">输出代表</el-button>\r\n          <el-button :type=\"selectedRows.length ? 'primary' : 'default'\" :disabled=\"selectedRows.length === 0\" @click=\"fetchSummaries\" :loading=\"summaryLoading\">摘要综合</el-button>\r\n          <el-button type=\"info\" size=\"small\" style=\"margin-left:8px\" @click=\"openSaveRecords\">保存记录</el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"right-table-wrapper\">\r\n        <el-table :data=\"pagedData\" stripe class=\"right-table\" @selection-change=\"handleSelectionChange\">\r\n        <el-table-column type=\"selection\" width=\"50\"></el-table-column>\r\n        <el-table-column type=\"index\" label=\"序号\" width=\"70\"></el-table-column>\r\n        <el-table-column prop=\"jybh\" label=\"建议编号\" width=\"120\"></el-table-column>\r\n        <el-table-column prop=\"title\" label=\"标题\" min-width=\"180\"></el-table-column>\r\n        <el-table-column prop=\"session\" label=\"届次\" width=\"120\"></el-table-column>\r\n        <el-table-column prop=\"representative\" label=\"代表\" width=\"140\"></el-table-column>\r\n        <el-table-column prop=\"delegation\" label=\"代表团\" width=\"140\"></el-table-column>\r\n        <el-table-column prop=\"cbdw\" label=\"承办单位\" width=\"160\"></el-table-column>\r\n        <el-table-column prop=\"reply\" label=\"答复字段\" min-width=\"200\"></el-table-column>\r\n        <el-table-column label=\"操作\" width=\"120\">\r\n          <template slot-scope=\"scope\">\r\n            <el-button type=\"text\" size=\"mini\">查看</el-button>\r\n          </template>\r\n        </el-table-column>\r\n        </el-table>\r\n      </div>\r\n\r\n      <div class=\"pagination-wrap\">\r\n        <el-pagination\r\n          background\r\n          :current-page.sync=\"currentPage\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"prev, pager, next, jumper\"\r\n          :total=\"totalCount\"\r\n          @current-change=\"onPageChange\"\r\n        >\r\n        </el-pagination>\r\n      </div>\r\n\r\n      <el-dialog :visible.sync=\"summaryDialogVisible\" width=\"70%\" :before-close=\"() => (summaryDialogVisible = false)\" append-to-body>\r\n        <span slot=\"title\">摘要汇总（{{ summaries.length }} 篇）</span>\r\n        <div class=\"summary-list\">\r\n          <div v-for=\"(s, idx) in summaries\" :key=\"idx\" class=\"summary-article\">\r\n            <h3>{{ s.title }}</h3>\r\n            <div v-for=\"(p, pi) in s.paragraphs\" :key=\"pi\" class=\"summary-paragraph\">{{ p }}</div>\r\n            <el-divider></el-divider>\r\n          </div>\r\n        </div>\r\n        <span slot=\"footer\" class=\"dialog-footer\">\r\n          <el-button @click=\"summaryDialogVisible = false\">关闭</el-button>\r\n        </span>\r\n      </el-dialog>\r\n\r\n      <el-dialog :visible.sync=\"repDialogVisible\" width=\"60%\" :before-close=\"() => (repDialogVisible = false)\" append-to-body>\r\n        <span slot=\"title\">代表信息汇总（{{ representativeList.length }} 位）</span>\r\n        <div class=\"summary-list\">\r\n          <div v-for=\"(r, idx) in representativeList\" :key=\"idx\" class=\"summary-article\">\r\n            <h3>{{ r.representative || '未知代表' }} <small v-if=\"r.delegation\">（{{ r.delegation }}）</small></h3>\r\n            <div class=\"summary-paragraph\">承办单位：{{ r.cbdw || '-' }} ｜ 届次：{{ r.session || '-' }}</div>\r\n            <div class=\"summary-paragraph\">相关事项：</div>\r\n            <ul class=\"rep-items\">\r\n              <li v-for=\"(item, ii) in r.items\" :key=\"ii\">\r\n                <span class=\"rep-item-title\">{{ item.title || '未命名' }}</span>\r\n                <span class=\"rep-item-meta\" v-if=\"item.jybh\">（编号：{{ item.jybh }}）</span>\r\n              </li>\r\n            </ul>\r\n            <el-divider></el-divider>\r\n          </div>\r\n        </div>\r\n        <span slot=\"footer\" class=\"dialog-footer\">\r\n          <el-button @click=\"repDialogVisible = false\">关闭</el-button>\r\n        </span>\r\n      </el-dialog>\r\n\r\n      <!-- 保存记录对话框 -->\r\n      <el-dialog :visible.sync=\"saveDialogVisible\" title=\"保存的检索记录\" width=\"60%\" append-to-body>\r\n        <div>\r\n          <el-button type=\"primary\" size=\"small\" @click=\"saveCurrentRecord\">保存当前检索</el-button>\r\n        </div>\r\n        <div style=\"margin-top:12px\">\r\n          <el-table :data=\"savedRecords\" style=\"width:100%\">\r\n            <el-table-column prop=\"name\" label=\"名称\" min-width=\"160\"></el-table-column>\r\n            <el-table-column prop=\"ts\" label=\"时间\" width=\"180\"></el-table-column>\r\n            <el-table-column label=\"操作\" width=\"240\">\r\n              <template slot-scope=\"scope\">\r\n                <el-button size=\"mini\" type=\"text\" @click=\"viewSavedRecord(scope.$index)\">查看</el-button>\r\n                <el-button size=\"mini\" type=\"text\" @click=\"exportSavedRecord(scope.$index)\">导出</el-button>\r\n                <el-button size=\"mini\" type=\"text\" @click=\"deleteSavedRecord(scope.$index)\">删除</el-button>\r\n              </template>\r\n            </el-table-column>\r\n          </el-table>\r\n        </div>\r\n        <span slot=\"footer\" class=\"dialog-footer\">\r\n          <el-button @click=\"saveDialogVisible = false\">关闭</el-button>\r\n        </span>\r\n      </el-dialog>\r\n\r\n      <!-- 查看单条记录 -->\r\n      <el-dialog :visible.sync=\"viewDialogVisible\" title=\"查看记录详情\" width=\"70%\" append-to-body>\r\n        <div style=\"max-height:60vh; overflow:auto\">\r\n          <pre style=\"white-space:pre-wrap; word-break:break-word\">{{ viewingRecord ? JSON.stringify(viewingRecord, null, 2) : '' }}</pre>\r\n        </div>\r\n        <span slot=\"footer\" class=\"dialog-footer\">\r\n          <el-button @click=\"viewDialogVisible = false\">关闭</el-button>\r\n        </span>\r\n      </el-dialog>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { searchZF } from '../../api/login'\r\n\r\nexport default {\r\n  components: {},\r\n  data () {\r\n    return {\r\n      // 原始表格数据（全部数据）\r\n      allData: [\r\n        { id: 1, title: '关于加强环保立法的建议', jybh: '001', representative: '肖某某', cbdw: '中央某某机关', session: '第十三届', delegation: '代表团A', reply: '已转交相关部门处理。建议从源头治理，完善污水处理设施建设。', source: '建议库' },\r\n        { id: 2, title: '关于提升教育质量的提案', jybh: '002', representative: '李某', cbdw: '教育部', session: '第十二届', delegation: '代表团B', reply: '相关部门正在调研。将推进教师培训与课程改革。', source: '议案库' },\r\n        { id: 3, title: '关于农村交通改善的建议', jybh: '003', representative: '王某', cbdw: '交通运输部', session: '第十三届', delegation: '代表团C', reply: '已列入年度计划。优先打通乡村断头路。', source: '大会简报' },\r\n        { id: 4, title: '关于城市污水处理的建议', jybh: '004', representative: '赵某', cbdw: '生态环境部', session: '第十三届', delegation: '代表团D', reply: '建议完善污水管网，推动环保立法与执法联动。', source: '建议库' },\r\n        { id: 5, title: '关于安全生产监督的提案', jybh: '005', representative: '周某', cbdw: '应急管理部', session: '第十二届', delegation: '代表团E', reply: '加大执法力度，建立长效机制。', source: '议案库' },\r\n        { id: 6, title: '关于医疗资源均衡配置的建议', jybh: '006', representative: '钱某', cbdw: '国家卫健委', session: '第十三届', delegation: '代表团F', reply: '推动优质医疗资源下沉。', source: '建议库' },\r\n        { id: 7, title: '关于教育改革与师资培训', jybh: '007', representative: '孙某', cbdw: '教育部', session: '第十三届', delegation: '代表团B', reply: '完善教师激励机制。', source: '议案库' },\r\n        { id: 8, title: '关于城市交通拥堵治理', jybh: '008', representative: '吴某', cbdw: '交通运输部', session: '第十三届', delegation: '代表团C', reply: '推广智慧交通系统。', source: '大会简报' },\r\n        { id: 9, title: '关于农村污水处理设施建设', jybh: '009', representative: '郑某', cbdw: '生态环境部', session: '第十三届', delegation: '代表团A', reply: '加快推进农村污水治理试点。', source: '建议库' },\r\n        { id: 10, title: '关于医院信息化建设', jybh: '010', representative: '钱某', cbdw: '国家卫健委', session: '第十三届', delegation: '代表团F', reply: '推进电子病历互联互通。', source: '建议库' },\r\n        { id: 11, title: '关于交通安全宣传教育', jybh: '011', representative: '赵某', cbdw: '公安部', session: '第十二届', delegation: '代表团D', reply: '持续开展交通安全宣传。', source: '议案库' },\r\n        { id: 12, title: '关于环保执法协同的建议', jybh: '012', representative: '陈某', cbdw: '生态环境部', session: '第十三届', delegation: '代表团A', reply: '建立跨部门联合执法机制。', source: '建议库' }\r\n      ],\r\n      // 一次检索结果（左侧列表）\r\n      primaryResults: [],\r\n      // 左侧可选项选中集（来自 responseData）\r\n      selectedKeywords: [],\r\n      selectedSegmentIntros: [],\r\n      selectedSegmentContents: [],\r\n      // per-origin highlight state (clicking a tag highlights only within that origin)\r\n      highlightedHotspots: [],\r\n      highlightedKeySuggestions: [],\r\n      highlightedPrimary: [],\r\n      // 二次检索结果（右侧表格）\r\n      secondaryResults: [],\r\n      // 拓展项，示例数据；真实场景应由后端或扩展算法生成\r\n      expandedItems: [\r\n        { id: 1, text: '环保' },\r\n        { id: 2, text: '教育' },\r\n        { id: 3, text: '交通' },\r\n        { id: 4, text: '立法' },\r\n        { id: 5, text: '调研' }\r\n      ],\r\n      // 可选的库类型（作为拓展词的前置条件）\r\n      categories: [\r\n        { label: '议案库', value: '议案库' },\r\n        { label: '建议库', value: '建议库' },\r\n        { label: '大会简报', value: '大会简报' }\r\n      ],\r\n      selectedCategory: '',\r\n      // 热点下拉多选项\r\n      hotspots: [\r\n        { label: '环境', value: '环境' },\r\n        { label: '安全', value: '安全' },\r\n        { label: '教育', value: '教育' },\r\n        { label: '交通', value: '交通' },\r\n        { label: '医疗', value: '医疗' }\r\n      ],\r\n      selectedHotspots: [],\r\n      // 重点建议\r\n      keySuggestions: [\r\n        { label: '环保立法', value: '环保立法' },\r\n        { label: '教育改革', value: '教育改革' },\r\n        { label: '交通改善', value: '交通改善' }\r\n      ],\r\n      selectedKeySuggestions: [],\r\n      // 左侧初次结果勾选集合\r\n      selectedPrimary: [],\r\n      selectedExpanded: [],\r\n      select: '1',\r\n      leftSelectCategory: 'hotspot',\r\n      input3: '交通管制',\r\n      // 分页与选择状态\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      selectedRows: [],\r\n      // 摘要相关\r\n      summaryDialogVisible: false,\r\n      summaries: [],\r\n      summaryLoading: false,\r\n      // 代表信息汇总\r\n      repDialogVisible: false,\r\n      repLoading: false,\r\n      representativeList: [],\r\n      // 已选择的上传文件列表\r\n      // 保存记录相关\r\n      saveDialogVisible: false,\r\n      savedRecords: [],\r\n      viewDialogVisible: false,\r\n      viewingRecord: null,\r\n      uploadedFiles: [],\r\n      // 左侧 Tab 激活项\r\n      activeLeftTab: 'search',\r\n      responseData: [],\r\n      responseData2: [\r\n        {\n          id: 0,\n          c_fwjg: '​财政部办公厅 住房城乡建设部办公厅',\n          c_nf: '2025',\n          id: 23856488,\r\n          keywords: ['机制', '城市', '城市更新', '资金', '支持', '项目', '中央', '建设', '探索', '形成'],\r\n          title: '关于开展2025年度中央财政支持实施城市更新行动的通知',\r\n          segments: [{\r\n            content: '一、工作目标\\n财政部会同住房城乡建设部通过竞争性选拔，确定部分基',\r\n            intro: '一、工作目标\\n财政部会同住房城乡建设部通过竞争性选拔，确定部分基'\r\n          }, {\r\n            content: '四、补助标准和支持范围。（一）中央财政资金补助标准。中央财政按区域对实施城市更新行动城市给予定额补助。其中：东部地区每个城市补助总额不超过8亿元，中部地区每个城市补助总额不超过10亿元，西部地区每个城市补助总额不超过12亿元，直辖市每个城市补助总额不超过12亿元。资金根据工作推进情况分年拨付到位。（二）资金支持方向。中央财政资金支持城市更新的样板项目建设和机制建设2个方向：。1.城市更',\r\n            intro: '四、补助标准和支持范围。'\r\n          }\r\n          ]\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    totalCount() {\r\n      return this.secondaryResults.length\r\n    },\r\n    pagedData() {\r\n      const start = (this.currentPage - 1) * this.pageSize\r\n      return this.secondaryResults.slice(start, start + this.pageSize)\r\n    },\r\n    // 从 primaryResults 聚合出关键词与分段\r\n    displayedKeywords() {\r\n      const set = new Set()\r\n      ;(this.primaryResults || []).forEach(item => {\r\n        ;(item.keywords || []).forEach(k => set.add(k))\r\n      })\r\n      return Array.from(set)\r\n    },\r\n    displayedSegments() {\r\n      const list = [];\r\n      (this.primaryResults || []).forEach(item => {\r\n        (item.segments || []).forEach(seg => {\r\n          console.log('Segment:', seg)\r\n          if (seg && (seg.intro || seg.content)) {\r\n            list.push({ intro: seg.intro || '', content: seg.content || '' })\r\n          }\r\n        })\r\n      })\r\n      console.log('Displayed Segments:', list)\r\n      return list\r\n    },\r\n    computedSearchPlaceholder() {\r\n      if (this.selectedHotspots.length || this.selectedKeySuggestions.length) {\r\n        const hs = this.selectedHotspots.join('、')\r\n        const ks = this.selectedKeySuggestions.join('、')\r\n        const parts = []\r\n        if (hs) parts.push(`热点: ${hs}`)\r\n        if (ks) parts.push(`重点: ${ks}`)\r\n        return parts.join(' | ') + '，可输入关键词…'\r\n      }\r\n      return '请输入词、语句、篇'\r\n    }\r\n  },\r\n  mounted () {\r\n    // 初始化表格显示\r\n    // 将后端响应示例赋值为一次检索结果来源\r\n    this.primaryResults = Array.isArray(this.responseData) ? this.responseData : []\r\n    // 为二次检索结果填充测试数据（默认展示全部示例数据）\r\n    this.secondaryResults = this.allData.slice()\r\n    this.currentPage = 1\r\n  },\r\n  methods: {\r\n    handleSelectionChange(rows) {\r\n      this.selectedRows = rows || []\r\n    },\r\n\r\n    onPageChange(page) {\r\n      this.currentPage = page\r\n    },\r\n\r\n    async fetchSummaries() {\r\n      if (!this.selectedRows || this.selectedRows.length === 0) return\r\n      this.summaryLoading = true\r\n      try {\r\n        // TODO: 将此处替换为真实的后端 API 调用。\r\n        // 示例：const res = await api.post('/summaries', { ids: this.selectedRows.map(r => r.id) })\r\n        // 下面用模拟数据代替，按每个选中项生成若干段落\r\n        await new Promise(resolve => setTimeout(resolve, 700))\r\n        this.summaries = this.selectedRows.map(r => {\r\n          // 简单按句号拆分为段落，如果没有句号则做为一段\r\n          const text = (r.reply || '')\r\n          const parts = text.split('。').filter(p => p && p.trim())\r\n          const paragraphs = parts.length ? parts.map(p => p + '。') : [text || '无摘要内容']\r\n          return { title: r.title || '未命名', paragraphs }\r\n        })\r\n        this.summaryDialogVisible = true\r\n      } catch (err) {\r\n        this.$message && this.$message({ message: '摘要请求失败', type: 'error' })\r\n      } finally {\r\n        this.summaryLoading = false\r\n      }\r\n    },\r\n    onSearch() {\r\n      searchZF({ text: this.input3 }).then(res => {\r\n        // 处理查询的数据\r\n        console.log('searchZF response:', res)\r\n        this.responseData = res.data || []\r\n        // 将 responseData 赋值到一次检索结果，用于展示关键词与分段\r\n        this.primaryResults = Array.isArray(this.responseData) ? this.responseData : []\r\n        console.log('Primary Results:', this.primaryResults)\r\n        // 重置左侧选择\r\n        this.selectedKeywords = []\r\n        this.selectedSegmentIntros = []\r\n        this.selectedSegmentContents = []\r\n        this.currentPage = 1\r\n      }).catch(err => {\r\n        console.error('searchZF error:', err)\r\n      })\r\n    },\r\n\r\n    onOptionsChange(val) {\r\n      // val can be an array (multiple select) or a single value\r\n      this.addSelectedToInput(val)\r\n    },\r\n\r\n    addSelectedToInput(values) {\r\n      if (!values) return\r\n      const arr = Array.isArray(values) ? values : [values]\r\n      if (!arr.length) return\r\n      const existing = (this.input3 || '').trim()\r\n      const existingTokens = new Set(existing.split(/\\s+/).filter(Boolean))\r\n      const newTokens = arr.filter(t => t && !existingTokens.has(t))\r\n      if (!newTokens.length) return\r\n      this.input3 = existing ? (existing + ' ' + newTokens.join(' ')) : newTokens.join(' ')\r\n    },\r\n\r\n    removeHotspot(val) {\r\n      this.selectedHotspots = this.selectedHotspots.filter(v => v !== val)\r\n    },\r\n\r\n    removeKeySuggestion(val) {\r\n      this.selectedKeySuggestions = this.selectedKeySuggestions.filter(v => v !== val)\r\n    },\r\n\r\n    onLeftCategoryChange(val) {\r\n      // when switching category, clear selections of the other category\r\n      if (val === 'hotspot') {\r\n        this.selectedKeySuggestions = []\r\n      } else if (val === 'keySuggestion') {\r\n        this.selectedHotspots = []\r\n      }\r\n    },\r\n\r\n    onItemTitleChange(item) {\r\n      const title = item.title\r\n      const checked = this.selectedPrimary && this.selectedPrimary.includes(title)\r\n      if (checked) {\r\n        // add all segments (intro/content) of this item to selections\r\n        ;(item.segments || []).forEach(seg => {\r\n          if (seg && seg.intro) {\r\n            if (!this.selectedSegmentIntros.includes(seg.intro)) this.selectedSegmentIntros.push(seg.intro)\r\n          }\r\n          if (seg && seg.content) {\r\n            if (!this.selectedSegmentContents.includes(seg.content)) this.selectedSegmentContents.push(seg.content)\r\n          }\r\n        })\r\n        // also add this item's keywords to selectedKeywords\r\n        ;(item.keywords || []).forEach(kw => {\r\n          if (!this.selectedKeywords.includes(kw)) this.selectedKeywords.push(kw)\r\n        })\r\n      } else {\r\n        // remove any segments belonging to this item from selections\r\n        ;(item.segments || []).forEach(seg => {\r\n          if (seg && seg.intro) this.selectedSegmentIntros = this.selectedSegmentIntros.filter(s => s !== seg.intro)\r\n          if (seg && seg.content) this.selectedSegmentContents = this.selectedSegmentContents.filter(s => s !== seg.content)\r\n        })\r\n        // remove this item's keywords from selectedKeywords\r\n        ;(item.keywords || []).forEach(kw => {\r\n          this.selectedKeywords = this.selectedKeywords.filter(k => k !== kw)\r\n        })\r\n      }\r\n    },\r\n\r\n    toggleHighlight(kw, origin, item, originIndex, kwIndex) {\r\n      // origin: 'primary' | 'hotspot' | 'keySuggestion'\r\n      if (!origin) return\r\n      if (origin === 'hotspot') {\r\n        const key = 'hotspot:' + originIndex\r\n        const i = this.highlightedHotspots.indexOf(key)\r\n        if (i === -1) this.highlightedHotspots.push(key)\r\n        else this.highlightedHotspots.splice(i, 1)\r\n        return\r\n      }\r\n      if (origin === 'keySuggestion') {\r\n        const key = 'keySuggestion:' + originIndex\r\n        const i = this.highlightedKeySuggestions.indexOf(key)\r\n        if (i === -1) this.highlightedKeySuggestions.push(key)\r\n        else this.highlightedKeySuggestions.splice(i, 1)\r\n        return\r\n      }\r\n      // primary origin: use item index and keyword index to form unique key\r\n      const pKey = 'primary:' + originIndex + ':' + kwIndex\r\n      const pi = this.highlightedPrimary.indexOf(pKey)\r\n      if (pi === -1) {\r\n        this.highlightedPrimary.push(pKey)\r\n        // keep selectedKeywords in sync (by value) if not present\r\n        if (kw && !this.selectedKeywords.includes(kw)) this.selectedKeywords.push(kw)\r\n        // ensure title selected (but do NOT auto-select segments)\r\n        const t = item && item.title\r\n        if (t && (!this.selectedPrimary || !this.selectedPrimary.includes(t))) {\r\n          if (!this.selectedPrimary) this.selectedPrimary = []\r\n          this.selectedPrimary.push(t)\r\n        }\r\n      } else {\r\n        this.highlightedPrimary.splice(pi, 1)\r\n        // remove from selectedKeywords by value when un-highlighting primary\r\n        if (kw) this.selectedKeywords = this.selectedKeywords.filter(k => k !== kw)\r\n      }\r\n    },\r\n\r\n    // (removed) tagStatus — highlighting now uses index-keyed arrays (highlightedHotspots, highlightedKeySuggestions, highlightedPrimary)\r\n\r\n    exportRepresentatives() {\r\n      if (!this.selectedRows || this.selectedRows.length === 0) return\r\n      this.repLoading = true\r\n      try {\r\n        const map = {}\r\n        this.selectedRows.forEach(r => {\r\n          const key = r.representative || '未知代表'\r\n          if (!map[key]) {\r\n            map[key] = {\r\n              representative: r.representative || '未知代表',\r\n              delegation: r.delegation || r.delegationName || '',\r\n              cbdw: r.cbdw || '',\r\n              session: r.session || '',\r\n              items: []\r\n            }\r\n          }\r\n          map[key].items.push({ title: r.title, jybh: r.jybh })\r\n        })\r\n        this.representativeList = Object.values(map)\r\n        this.repDialogVisible = true\r\n      } catch (err) {\r\n        this.$message && this.$message({ message: '输出代表信息失败', type: 'error' })\r\n      } finally {\r\n        this.repLoading = false\r\n      }\r\n    },\r\n\r\n    openSaveRecords() {\r\n      this.saveDialogVisible = true\r\n    },\r\n\r\n    saveCurrentRecord() {\r\n      // capture left-side parameters and current secondaryResults\r\n      const rec = {\r\n        name: `检索-${new Date().toISOString()}`,\r\n        ts: new Date().toLocaleString(),\r\n        query: {\r\n          input: this.input3,\r\n          hotspots: this.selectedHotspots.slice(),\r\n          keySuggestions: this.selectedKeySuggestions.slice(),\r\n          selectedKeywords: this.selectedKeywords.slice(),\r\n          selectedSegmentIntros: this.selectedSegmentIntros.slice(),\r\n          selectedSegmentContents: this.selectedSegmentContents.slice(),\r\n          category: this.selectedCategory || ''\r\n        },\r\n        results: this.secondaryResults.slice()\r\n      }\r\n      this.savedRecords.unshift(rec)\r\n      this.$message && this.$message({ message: '已保存当前检索记录', type: 'success' })\r\n    },\r\n\r\n    viewSavedRecord(idx) {\r\n      const r = this.savedRecords[idx]\r\n      if (!r) return\r\n      this.viewingRecord = r\r\n      this.viewDialogVisible = true\r\n    },\r\n\r\n    deleteSavedRecord(idx) {\r\n      this.savedRecords.splice(idx, 1)\r\n      this.$message && this.$message({ message: '已删除记录', type: 'info' })\r\n    },\r\n\r\n    exportSavedRecord(idx) {\r\n      const r = this.savedRecords[idx]\r\n      if (!r) return\r\n      // export as JSON file\r\n      const blob = new Blob([JSON.stringify(r, null, 2)], { type: 'application/json;charset=utf-8' })\r\n      const url = URL.createObjectURL(blob)\r\n      const a = document.createElement('a')\r\n      a.href = url\r\n      a.download = (r.name || 'record') + '.json'\r\n      document.body.appendChild(a)\r\n      a.click()\r\n      document.body.removeChild(a)\r\n      URL.revokeObjectURL(url)\r\n    },\r\n\r\n    secondarySearch() {\r\n      if (!this.selectedCategory) {\r\n        this.$message && this.$message({ message: '请先选择来源库（议案库/建议库/大会简报）', type: 'warning' })\r\n        return\r\n      }\r\n      // 至少选择了关键词或分段内容之一\r\n      const hasCond = (this.selectedKeywords && this.selectedKeywords.length) ||\r\n                      (this.selectedSegmentIntros && this.selectedSegmentIntros.length) ||\r\n                      (this.selectedSegmentContents && this.selectedSegmentContents.length)\r\n      if (!hasCond) {\r\n        this.$message && this.$message({ message: '请在左侧选择关键词或分段作为条件', type: 'warning' })\r\n        return\r\n      }\r\n      // 组合选择条件\r\n      const sels = [\r\n        ...(this.selectedKeywords || []),\r\n        ...(this.selectedSegmentIntros || []),\r\n        ...(this.selectedSegmentContents || [])\r\n      ].map(s => String(s).toLowerCase())\r\n      const filtered = this.allData.filter(r => {\r\n        if (!r.source || r.source !== this.selectedCategory) return false\r\n        const txt = ((r.title || '') + ' ' + (r.reply || '')).toLowerCase()\r\n        return sels.some(s => txt.includes(s))\r\n      })\r\n      this.secondaryResults = filtered\r\n      this.currentPage = 1\r\n      this.selectedRows = []\r\n    },\r\n\r\n    clearExpandedSelection() {\r\n      this.selectedExpanded = []\r\n      // 恢复右侧为一次检索结果\r\n      this.secondaryResults = this.primaryResults.slice()\r\n      this.currentPage = 1\r\n    },\r\n\r\n    // 清空搜索框时重置下拉选择\r\n    resetFilters() {\r\n      this.selectedHotspots = []\r\n      this.selectedKeySuggestions = []\r\n      // 重置为全部/关键词初次结果\r\n      this.onSearch()\r\n    },\r\n    // 清空左侧关键词/分段选择\r\n    clearLeftSelections() {\r\n      this.selectedKeywords = []\r\n      this.selectedSegmentIntros = []\r\n      this.selectedSegmentContents = []\r\n    },\r\n    openFileDialog() {\r\n      this.$refs.fileInput && this.$refs.fileInput.click()\r\n    },\r\n\r\n    onFilesSelected(e) {\r\n      const files = e.target.files || []\r\n      for (let i = 0; i < files.length; i++) {\r\n        const file = files[i]\r\n        const id = Date.now() + '_' + i + '_' + file.name\r\n        const isImage = file.type && file.type.startsWith('image/')\r\n        const url = isImage ? URL.createObjectURL(file) : null\r\n        this.uploadedFiles.push({ id, name: file.name, size: file.size, humanSize: this.humanFileSize(file.size), isImage, url, raw: file })\r\n      }\r\n      // 清空 input，支持重复选择同一个文件\r\n      e.target.value = ''\r\n    },\r\n\r\n    removeFile(idx) {\r\n      const f = this.uploadedFiles[idx]\r\n      if (f && f.url) {\r\n        URL.revokeObjectURL(f.url)\r\n      }\r\n      this.uploadedFiles.splice(idx, 1)\r\n    },\r\n\r\n    previewFile(f) {\r\n      if (!f || !f.url) return\r\n      const w = window.open('')\r\n      if (w) {\r\n        w.document.write(`<title>${f.name}</title><img src=\"${f.url}\" style=\"max-width:100%;height:auto;display:block;margin:0 auto;\"/>`)\r\n      }\r\n    },\r\n\r\n    humanFileSize(size) {\r\n      if (size === 0) return '0 B'\r\n      const i = Math.floor(Math.log(size) / Math.log(1024))\r\n      const sizes = ['B', 'KB', 'MB', 'GB', 'TB']\r\n      return (size / Math.pow(1024, i)).toFixed(i ? 1 : 0) + ' ' + sizes[i]\r\n    },\r\n    handleGl(html) {\r\n      return html.replaceAll('<em>', '<span style=\"color: red\">').replaceAll('</em>', '</span>').replaceAll('\\n\\n', '\\n')\r\n    }\r\n  }\r\n}\r\n\r\n</script>\r\n\r\n<style scoped>\r\n/* Two-pane layout */\r\n.advice-layout{ display:flex; gap:16px; padding:10px; box-sizing:border-box; overflow-x:hidden; height: calc(100vh - 20px); font-size:13px; line-height:1.45 }\r\n.left-pane{ flex:0 0 48%; width:48%; min-width:0; min-height:0; overflow:auto }\r\n.right-pane{ flex:0 0 48%; width:48%; min-width:0; min