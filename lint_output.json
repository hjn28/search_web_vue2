dth:165px;\"  @click=\"siderSearch('fwjg','国务院部门文件','gwybmwj')\">国务院部门文件({{organization.bmfl.count}})</a>\n                </div>\n                <ul :ref=\"`showList2_4`\" class=\"no-bullets\" style=\"display:none;text-indent:1.25rem;\">\n                  <li v-if=\"val_4.count > 0\" :ref=\"`gwybmwj_${index_4}`\" class=\"cursor\" v-for=\"(val_4,index_4) in organization.bmfl.data\" :key=\"index_4\" @click=\"siderSearch('fwjg',`${val_4.name}`,`gwybmwj_${index_4}`)\">{{val_4.name }}({{ val_4.count }})</li>\n                </ul>\n              </li>\n            </ul>\n          </div> -->\n          <!-- <div class=\"sider sider_2\" @click=\"siderSearch('fwjg','解读','zcjd')\">政策解读({{siderList.jieduNum}}条)</div> -->\n        </div>\n        <div class=\"cont\" style=\"float:left;width:40rem;\">\n          <div class=\"main\">\n            <div class=\"contBox\" v-for=\"(item, index) in documnetData\" :key=\"index\">\n              <h5 class=\"theme\" v-html=\"handleTitle(item.title)\" @click=\"tiaozhuan(item.content_html,item.title,item.list)\"></h5>\n              <p class=\"content\" v-html=\"handleTitle(item.content)\"></p>\n              <div style=\"min-height:1.5rem\">\n                <div v-if=\"item.c_fwjg\" class=\"source\">\n                  <div class=\"con_btn con_btn1\">{{item.c_fwjg}}</div>\n                </div>\n                <div v-for=\"(im,in2) in item.list\" :key=\"in2\" class=\"source\">\n                  <div v-show=\"im.show === 'true'\" class=\"con_btn con_btn1\">{{im.name}}：{{im.value}}</div>\n                </div>\n                <div style=\"clear:both\"></div>\n              </div>\n              <div class=\"line\"></div>\n            </div>\n            <el-pagination\n              v-show=\"documnetData.length > 0\"\n              @size-change=\"handleSizeChange\"\n              @current-change=\"handleCurrentChange\"\n              :current-page.sync=\"pagetion.currentPage\"\n              :page-size=\"pagetion.pageSize\"\n              :page-sizes=\"[10, 20, 50, 100]\"\n              layout=\"total, prev, pager, next,jumper\"\n              :total=\"pagetion.total\">\n            </el-pagination>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport { zcSearch } from '@/api/login.js'\nimport ReturnTop from '@/components/returnTop.vue'\nexport default {\n  components: {\n    ReturnTop\n  },\n  data () {\n    return {\n      inputValue: '', // 关键字\n      defaultProps: {\n        children: 'children',\n        label: 'label'\n      },\n      siderList: [\n        {\n          label: '1',\n          name: '按主题分类(xxxx条)'\n        },\n        {\n          label: '2',\n          name: '按发布机构分类(xxxx条)'\n        }\n      ],\n      pagetion: {\n        currentPage: 1,\n        pageSize: 10,\n        total: 0\n      },\n      aztFlag: false,\n      afbjgFlag: false,\n      listArr: [], // 用于存储点击之后的值\n      listArr2: [], // 按发布机构分类\n      fontColorRefArr: [],\n      documnetData: [],\n      sideCheckedArr: [], // 多选的时候，用来存储数据，方便处理\n      siderList: {\n        ztflNum: 0,\n        afbjgNUm: 0,\n        jieduNum: 0\n      },\n      ztflTree: [],\n      organization: {\n        bmfl: {\n          count: 0\n        },\n        groupMap: {\n          count: 0\n        }\n      },\n      searchFlag: false,\n      searchCs: [],\n      imgUrl1: '',\n      statistics: [],\n      isCheck: true,\n      themTitle: '国务院政策文件库',\n      currentDom: '',\n      database: '001'\n    }\n  },\n\n  computed: {},\n  mounted() {\n    this.search()\n    const that = this\n    // 全局监听回车键\n    window.addEventListener('keydown', (e) => {\n      if (e.key === 'Enter' || e.keyCode === 13) {\n        that.search()\n      }\n    })\n  },\n  methods: {\n    search(val, page = 1) {\n      // database=001 政策文件库\n      console.log('this.searchCs', this.searchCs)\n      this.pagetion.currentPage = page\n      // ztfl 传参 需要携带头部名称，使用/隔断\n      // 国务院文件 fwzh;国务院部门