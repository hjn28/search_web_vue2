div v-for=\"(im, in2) in item.list\" :key=\"in2\" class=\"source\">\n                    <div v-show=\"im.show === 'true'\" class=\"con_btn con_btn1\">\n                      {{ im.name }}：{{ im.value }}\n                    </div>\n                  </div>\n                  <div style=\"clear: both\"></div>\n                </div>\n                <div class=\"line\"></div>\n              </div>\n              <el-pagination v-show=\"documnetData.length > 0\" @size-change=\"handleSizeChange\"\n                @current-change=\"handleCurrentChange\" :current-page.sync=\"pagetion.currentPage\"\n                :page-size=\"pagetion.pageSize\" :page-sizes=\"[10, 20, 50, 100]\" layout=\"total, prev, pager, next\"\n                :total=\"pagetion.total\" small>\n              </el-pagination>\n            </div>\n            <div v-else class=\"main\">\n              <Empty description=\"当前页面内容为空\"></Empty>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"zcwj\" v-if=\"zcwjVisible\">\n      <el-button size=\"small\" @click=\"() => {this.zcwjVisible = false}\">返回</el-button>\n      <Detail :query=\"query\"></Detail>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { zcSearch } from '@/api/login.js'\nimport ReturnTop from '@/components/returnTop.vue'\nimport Empty from '@/components/empty.vue'\nimport Detail from '@/views/police/detail.vue'\nexport default {\n  components: {\n    ReturnTop,\n    Empty,\n    Detail\n  },\n  data() {\n    return {\n      inputValue: '', // 关键字\n      defaultProps: {\n        children: 'children',\n        label: 'label'\n      },\n      pagetion: {\n        currentPage: 1,\n        pageSize: 10,\n        total: 0\n      },\n      aztFlag: false,\n      afbjgFlag: false,\n      listArr: [], // 用于存储点击之后的值\n      listArr2: [], // 按发布机构分类\n      fontColorRefArr: [],\n      documnetData: [],\n      sideCheckedArr: [], // 多选的时候，用来存储数据，方便处理\n      ztflTree: [],\n      organization: {\n        bmfl: {\n          count: 0\n        },\n        groupMap: {\n          count: 0\n        }\n      },\n      searchFlag: false,\n      // searchCs: [],\n      imgUrl1: '',\n      statistics: [],\n      isCheck: true,\n      isCheckZywj: true,\n      isCheckGwyzcwjk: false,\n      isCheckGjgzk: false,\n      isCheckMuti: false, // 是否多选\n      themTitle: '国务院政策文件库',\n      currentDom: '',\n      database: '002',\n      matchMode: '1', // 0 标题；1 为全文\n      sortMode: '0', // 0 相似度降序 1 时间降序\n      // wjkValue:['国务院政策文件库'],\n      wjkValue: '中央文件',\n      wjkOptions: [\n        {\n          value: '中央文件',\n          label: '中央文件'\n        },\n        {\n          value: '国务院政策文件库',\n          label: '国务院政策文件库'\n        },\n        {\n          value: '国务规章库',\n          label: '国务规章库'\n        }\n      ],\n      checkObjArr: [],\n      sideSearchXL: {},\n      // checkedArr: [true, false, false]\n      zywjNum: '',\n      gwyzcwjNum: '',\n      gjgzkNum: '',\n      zcwjVisible: false,\n      query: {}\n    }\n  },\n\n  computed: {\n    checkedArr() {\n      return [this.isCheckZywj, this.isCheckGwyzcwjk, this.isCheckGjgzk]\n    }\n  },\n  mounted() {\n    this.search()\n    this.zcwjVisible = false\n    const that = this\n    // 全局监听回车键\n    window.addEventListener('keydown', (e) => {\n      if (e.key === 'Enter' || e.keyCode === 13) {\n        that.search()\n      }\n    })\n  },\n  methods: {\n    search(val, page = 1) {\n      // database=001 政策文件库\n      this.pagetion.currentPage = page\n      // ztfl 传参 需要携带头部名称，使用/隔断\n      // 国务院文件 fwzh;国务院部门文件 fwjg\n      // 政策文本解析分类\n      // if (val === 'chs') {\n      //   this.searchCs = []\n      // }\n\n      // matchMode 0\n      let formList = {\n        keyword: this.inputValue,\n        matchMode: this.matchMode, // 0 标题；1 为全文\n        sortMode: this.sortMode, // 排序 0 相似度降序 1 时间降序\n        page: this.pagetion.currentPage,\n        size: this.pagetion.pageSize,\n        database: this.database\n      }\n      // if (this.searchCs) {\n      //   formList[this.searchCs[0]] = this.searchCs[1]\n      // }\n      if (this.sideSearchXL) {\n        formList = { ...formList, ...this.sideSearchXL }\n      }\n      zcSearch(formList).then((res) => {\n        this.statistics = []\n        if (res.code === 200) {\n          let resData = res?.data\n          this.documnetData = resData?.documents\n          this.pagetion.total = resData.totalElements\n          this.searchFlag = true\n          if (resData.statistics.length > 0) {\n            // console.log(resData.statistics[0])\n            // console.log(resData.statistics[0].children[0])\n            this.statistics = resData.statistics[0].children[0]\n          }\n          this.zywjNum = ''\n          this.gwyzcwjNum = ''\n          this.gjgzkNum = ''\n          if (this.database === '001') {\n            this.themTitle = '中央文件（' + resData.totalElements + '件）'\n          }\n          if (this.database === '002') {\n            this.themTitle = '国务院政策文件库（' + resData.totalElements + '件）'\n          }\n          if (this.database === '003') {\n            this.themTitle = '国家规章库（' + resData.totalElements + '件）'\n          }\n          // console.log('this.statistics:', this.statistics)\n        }\n      })\n    },\n    handleNodeClick(data) {\n      console.log(data)\n    },\n    handleCurrentChange(val) {\n      this.pagetion.currentPage = val\n      this.search('', val)\n    },\n    handleSizeChange(val) {\n      console.log(val)\n      this.pagetion.pageSize = val\n      this.search()\n    },\n    click(val, it) {\n      if (val === 0) {\n        this.aztFlag = !this.aztFlag\n        this.afbjgFlag = false\n        this.$refs.menuList_0[0].style.display = 'block'\n        this.$refs.menuList_1[0].style.display = 'none'\n        if (this.aztFlag) {\n          this.$refs.menuList_0[0].style.display = 'block'\n        } else {\n          this.$refs.menuList_0[0].style.display = 'none'\n        }\n      }\n      if (val === 1) {\n        