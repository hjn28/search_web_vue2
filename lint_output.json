t_0[0].style.display = 'block'\n        } else {\n          this.$refs.menuList_0[0].style.display = 'none'\n        }\n      }\n      if (val === 1) {\n        this.afbjgFlag = !this.afbjgFlag\n        this.aztFlag = false\n        this.$refs.menuList_1[0].style.display = 'block'\n        this.$refs.menuList_0[0].style.display = 'none'\n        if (this.afbjgFlag) {\n          this.$refs.menuList_1[0].style.display = 'block'\n        } else {\n          this.$refs.menuList_1[0].style.display = 'none'\n        }\n      }\n      if (val === 2) {\n        this.afbjgFlag = false\n        this.aztFlag = false\n        this.$refs.menuList_1[0].style.display = 'none'\n        this.$refs.menuList_0[0].style.display = 'none'\n        this.siderSearch(1, '解读', 'zcjd')\n      }\n    },\n    showList(val) {\n      // console.log(this.$refs[`showTb_${val}`][0].classList.add('el-icon-folder-add'))\n      // console.log(this.$refs[`showTb_${val}`][0].classList.add('el-icon-folder-remove'))\n      if (this.listArr.includes(val)) {\n        this.$refs[`showListZt_${val}`][0].style.display = 'none'\n        this.$refs[`showTb_${val}`][0].classList.add('el-icon-folder-add')\n        this.$refs[`showTb_${val}`][0].classList.remove('el-icon-folder-remove')\n        this.listArr = this.listArr.filter((item) => item !== val)\n      } else {\n        this.listArr.push(val)\n        this.$refs[`showListZt_${val}`][0].style.display = 'block'\n        this.$refs[`showTb_${val}`][0].classList.add('el-icon-folder-remove')\n        this.$refs[`showTb_${val}`][0].classList.remove('el-icon-folder-add')\n      }\n    },\n    showList2(val) {\n      if (this.listArr2.includes(val)) {\n        this.$refs[`showList2_${val}`].style.display = 'none'\n        this.listArr2 = this.listArr2.filter((item) => item !== val)\n        this.$refs[`showTb2_${val}`].classList.add('el-icon-folder-add')\n        this.$refs[`showTb2_${val}`].classList.remove('el-icon-folder-remove')\n      } else {\n        this.listArr2.push(val)\n        this.$refs[`showList2_${val}`].style.display = 'block'\n        this.$refs[`showTb2_${val}`].classList.add('el-icon-folder-remove')\n        this.$refs[`showTb2_${val}`].classList.remove('el-icon-folder-add')\n      }\n    },\n    expand(val) {\n      // console.log(val)\n      this.$refs[`showListZt_${val}`].style.display = 'none'\n      this.listArr = this.listArr.filter((item) => item !== val)\n    },\n    // 左侧主题搜索分类\n    siderSearch(index, value, refSra, m) {\n      if (refSra !== 'zcjd') {\n        // console.log('refSra:', refSra)\n        this.currentDom = this.$refs[`${refSra}`][0]\n      }\n      this.searchCs = []\n      console.log('index:', index)\n      console.log('m:', m)\n      if (this.database === '001') {\n        if (index === 0) {\n          this.searchCs.push('ztfl')\n        }\n        if (index === 1) {\n          this.searchCs.push('fwjg')\n        }\n        if (index === 1 && m === 0) {\n          this.searchCs[0] = 'fwzh'\n        }\n      }\n      if (this.database === '002') {\n        this.searchCs.push('fwjg')\n      }\n      this.searchCs.push(value)\n      console.log('this.searchCs', this.searchCs)\n      // 针对点击元素进行添加类 移出类操作\n      if (this.database === '001') {\n        if (refSra !== 'zcjd') {\n          if (this.fontColorRefArr.length > 0) {\n            // if(this.fontColorRefArr[0] === 'gwywj' || this.fontColorRefArr[0] === 'gwybmwj'){\n            //   this.$refs[`${this.fontColorRefArr[0]}`].classList.remove('active');\n            // }else {\n            // }\n            this.$refs[`${this.fontColorRefArr[0]}`][0].classList.remove('active')\n            this.fontColorRefArr = []\n          }\n          this.fontColorRefArr.push(refSra)\n          this.$refs[`${refSra}`][0].classList.add('active')\n          // if(refSra === 'gwywj' || refSra === 'gwybmwj'){\n          //   this.$refs[`${refSra}`].classList.add('active');\n          // } else {\n          // }\n        } else {\n          if (this.fontColorRefArr.length > 0) {\n            this.$refs[`${this.fontColorRefArr[0]}`][0].classList.remove('active')\n            // if(this.fontColorRefArr[0] === 'gwywj' || this.fontColorRefArr[0] === 'gwybmwj'){\n            //   this.$refs[`${this.fontColorRefArr[0]}`].classList.remove('active');\n            // }else {\n            // }\n            // this.fontColorRefArr = [];\n          }\n        }\n      }\n      if (this.database === '002') {\n        if (this.fontColorRefArr.length > 0) {\n          this.$refs[`${this.fontColorRefArr[0]}`][0].classList.remove('active')\n        }\n        this.fontColorRefArr.push(refSra)\n        this.$refs[`${refSra}`][0].classList.add('active')\n        // this.fontColorRefArr = [];\n      }\n      let formList = {\n        keyword: this.inputValue,\n        matchMode: '1',\n        sortMode: '1',\n        page: this.pagetion.currentPage,\n        size: this.pagetion.pageSize,\n        database: this.database\n      }\n      if (this.searchCs) {\n        formList[this.searchCs[0]] = this.searchCs[1]\n      }\n      zcSearch(formList).then((res) => {\n        console.log('res:', res)\n        if (res.code === 200) {\n          let resData = res?.data\n          this.documnetData = resData?.documents\n          this.pagetion.total = resData.totalElements\n        }\n      })\n    },\n    // title关键字标红提示\n    handleTitle(title) {\n      let title2 = title.replaceAll('<em>', '<span style=\"color:red;\">').replaceAll('</em>', '</span>')\n      return title2\n    },\n    // tiaohzuna(data){\n    //     const route = this.$router.resolve({\n    //       name: 'searchDetail',\n    //       params: { data }\n    //     })\n    //     window.open(route.href, '_blank')\n    // },\n    tiaozhuan(data, title, list) {\n      this.$router.push({\n        name: 'searchDetail',\n        query: {\n          content: data,\n          title,\n          list\n        }\n      })\n    },\n    // 重置搜索内容，以及左侧搜索条件\n    resetValue() {\n      this.inputValue = ''\n      this.searchCs = []\n      console.log('this.searchCs:', this.searchCs)\n      if (this.currentDom) {\n        this.currentDom.classList.remove('active')\n      }\n      // this.listArr\n    },\n    handCons(val) {\n      console.log('val:', val)\n      return val.name\n    },\n    changeCheck(val) {\n      // 1为政策文件库 2规章库\n      this.isCheck = !this.isCheck\n      this.searchCs = []\n      this.listArr = []\n      if (val === 1) {\n        this.themTitle = '国务院政策文件库'\n        this.database = '001'\n        this.search()\n      } else if (val === 2) {\n        this.themTitle = '国家规章库'\n        this.database = '002'\n        this.search()\n      }\n    }\n  }\n}\n\n</script>\n\n<style scoped lang=\"less\">\n.warp{\n  // display: flex;\n  // justify-content: center;\n  font-size:0.5rem;\n}\n.container{\n  // width: 1200px;\n  // padding: 0 36px 60px;\n  margin:0 auto;\n}\n  .header{\n    height: 100px;\n    margin-top:5px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    .title_sty{\n      position:absolute;\n      left:5.625rem;\n      .title2{\n        // text-align: center;\n        // color: #ed4545;\n        // float:left;\n        margin-right:20px;\n        font-weight:500;\n        font-size:1rem;\n        .inpCheck{\n          width:0.65rem;\n          height:0.65rem;\n        }\n      }\n    }\n    .themTitle{\n        text-align: center;\n        color: #ed4545;\n        font-weight:500;\n        font-size:1.25rem;\n    }\n    .input-with-select{\n      -webkit-appearance: none;\n      background-color: #fff;\n      background-image: none;\n      border-radius: 7px 0 0 7px;\n      border: 1px solid red;\n      box-sizing: border-box;\n      color: #606266;\n      display: inline-block;\n      font-size: 12px;\n      height: 32px;\n      line-height: 32px;\n      outline: 0;\n      padding: 0 15px;\n      transition: border-color .2s red;\n      width: 294px;\n    }\n    .searchBtn{\n      background-color: red;\n      color: #fff;\n      width: 60px;\n      height: 32px;\n      font-size: 20px;\n      display:flex;\n      justify-content:center;\n      align-items:center;\n      border-radius:0 7px 7px 0;\n      // border: 1px solid red;\n    }\n    .btn{\n      margin-left: 10px;\n      background-color: red;\n      color: #fff;\n      float: left;\n      font-size: 18px;\n      // border: 1px solid red;\n      height: 2rem;\n      width: auto;\n      line-height: 2rem;\n      padding: 0 0.75rem;\n      font-size: 0.75rem;\n      border-radius: 5px;\n      cursor:pointer;\n    }\n  }\n  .sider_list{\n    width:10.25rem;\n    font-size:0.65rem;\n\n  }\n  .sider{\n    // width: 340px;\n    // padding:0 1rem;\n    height: 1.6rem;\n    line-height:1.6rem;\n    // line-height: 40px;\n    margin-bottom: 2px;\n    border-radius: 4px;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n    word-break: break-all; /* 确保长单词不被截断 */\n    -webkit-line-clamp: 1;\n  }\n  .sider_1{\n    text-align: center;\n    background: #ed4545;\n    color: #fff;\n  }\n  .sider_2{\n    text-indent: 1rem;\n    background:#e5adad;\n    cursor: pointer;\n  }\n  .no-bullets{\n    list-style-type: none;\n  }\n  .main{\n    // border-left: 1px solid #ccc;\n    border-left: 1px solid #efefef;\n    padding-left: 0.75rem;\n    width:40rem;\n    // border: 1px solid #eae2e2;\n    margin:0 10px;\n    border-radius: 4px;\n    padding-top: 0;\n    margin-bottom: 27px;\n    .contBox{\n      // padding-bottom: 21px;\n      margin-bottom: 18px;\n      border-bottom: 1px solid #efefef;\n      .theme{\n        font-family: 微软雅黑;\n        font-weight:600;\n        font-size: 0.65rem;\n        color: rgb(0, 0, 0);\n        line-height: 28px;\n        margin: 0;\n        overflow: hidden;\n        cursor:pointer;\n      }\n      .content{\n        font-family: 微软雅黑;\n        font-size: 0.58rem;\n        // color: rgb(158, 158, 158);\n        line-height: 1.2rem;\n        margin-bottom: 7px;\n        displa